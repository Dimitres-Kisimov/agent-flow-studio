{
  "name": "agent-flow-studio",
  "version": "1.0.0",
  "description": "A tiny, offline, zero-dependency visual agent-workflow builder — drag nodes, wire them up, and run flows with a deterministic mock reasoning engine.",
  "author": "Dimitres Kisimov",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "keywords": [
    "low-code",
    "agentic",
    "workflow",
    "no-code",
    "visual-programming",
    "graph-engine",
    "zero-dependency",
    "offline"
  ],
  "scripts": {
    "test": "node --test",
    "serve": "python -m http.server 8000",
    "lint:flows": "node scripts/lint-flows.js",
    "lint:flows:write": "node scripts/lint-flows.js --write",
    "lint:flows:check": "node scripts/lint-flows.js --check",
    "analyze:flows": "node scripts/analyze-flows.js",
    "analyze:flows:write": "node scripts/analyze-flows.js --write",
    "analyze:flows:check": "node scripts/analyze-flows.js --check"
  }
}
